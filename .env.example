# Blastradius environment. Copy to .env at the REPO ROOT (every entrypoint loads it explicitly).

# ── FalkorDB (holds all domain data and all agent memory; one graph per tenant)
FALKORDB_URL=redis://localhost:6380
FALKORDB_PASSWORD=
# Optional prefix for graph keys (<ns>_blastradius_acme). Integration tests use `itest` so they never touch the real graphs.
BLASTRADIUS_GRAPH_NAMESPACE=

# ── Postgres (app bookkeeping only: sessions, transcript, event log, actions, ingest jobs)
DATABASE_URL=postgres://blast:blast@localhost:5434/blastradius

# ── Agents
# auto = llm if an API key is present, else scripted. Force with llm | scripted.
AGENT_MODE=auto
LLM_PROVIDER=anthropic            # anthropic | openai
LLM_MODEL=claude-sonnet-5-5       # or e.g. gpt-5 when LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# direct = call packages/graph in-process; mcp = call the same tools through the MCP server
AGENT_TOOL_TRANSPORT=direct
MCP_URL=http://localhost:3333/mcp

# ── MCP server
MCP_PORT=3333
MCP_HOST=127.0.0.1                # HTTP bind address; the Docker image sets 0.0.0.0
MCP_ALLOW_WRITES=false            # true registers record_finding (graph writes) over MCP

# ── Embeddings (computed locally; no key). model | hash (deterministic fallback)
# Pre-fetch the model with `pnpm --filter @blastradius/mcp fetch-model`.
# NEVER mix backends in one graph: if you change this, reload with `pnpm graph:load` (resets).
EMBEDDINGS=model
HF_CACHE_DIR=.cache/hf

# ── Actions (each falls back to dry_run when unset; all are audit-logged)
GITHUB_TOKEN=
GITHUB_SANDBOX_REPO=              # owner/repo used for issues + rollback PRs
WEBHOOK_URL=                      # Slack or Discord incoming webhook
WEBHOOK_KIND=slack                # slack | discord

# ── Web
NEXT_PUBLIC_APP_NAME=Blastradius
# 1 = allow fixture replay (/?fixture=1) in a production build (always allowed in `next dev`)
NEXT_PUBLIC_ENABLE_FIXTURES=
# Next.js build dir (default .next); e.g. .next-build to run `next build` next to a running dev server
# NEXT_DIST_DIR=.next-build   (leave commented: an empty value would break next.config.ts)

# ── Docker host ports (docker-compose.yml)
FALKORDB_PORT=6380
FALKORDB_UI_PORT=3001
POSTGRES_PORT=5434
# Only used by `docker compose --profile app`: host port for web, and whether the image build bakes in the model
WEB_PORT=3000
FETCH_MODEL=true
