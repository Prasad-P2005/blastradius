        { "label": "Doc", "values": { "title": "ADR-001: Retry payment charges", "text": "We retry failed charges up to 5 times with exponential backoff (200 ms base) because the payment provider drops about 1% of requests. Every retry reuses the same idempotency key so a customer is never charged twice." } },
        { "label": "Decision", "values": { "key": "ADR-001", "title": "Retry payment charges with backoff", "status": "accepted", "decidedAt": "-10d", "context": "The payment provider drops about 1% of charge requests, which fails checkouts.", "decision": "Retry up to 5 times with exponential backoff and the same idempotency key." } },
        { "label": "Decision", "values": { "key": "ADR-002", "title": "Keep orders and payments in one Postgres", "status": "accepted", "decidedAt": "-200d", "context": "Orders and payments must commit together.", "decision": "One Postgres (orders-db) with both schemas; split later if load requires it." } },
        { "label": "Issue", "values": { "key": "OPS-12", "title": "Can payment retries double-charge?", "status": "open", "body": "With PR #101 we retry charges 5 times. If the provider times out after charging, do we charge twice? Need to verify idempotency keys end to end." } },
        { "label": "Thread", "values": { "title": "Why do we retry payments 5 times?", "channel": "#team-commerce", "text": "Dev Patel: why 5 retries on payments? Feels like a lot.\nBen Ortiz: the provider drops ~1% of requests; ADR-001 has the numbers. Idempotency keys keep it safe.\nChloe Wu: but the pool is small, so retries can queue up. Remember INC-001." } }
